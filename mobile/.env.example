# Copie este arquivo para .env e preencha para ativar a voz natural Azure.
# O .env não deve ser enviado ao Git nem compartilhado.

# azure = voz real | mock = áudio de teste sem chave
TTS_PROVIDER=azure

# Portal do Azure -> recurso Speech -> Chaves e ponto de extremidade
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_TTS_VOICE=pt-BR-ThalitaNeural

# Formato de saída do Azure (MP3 é o mais compatível com navegadores)
AZURE_TTS_FORMAT=audio-24khz-48kbitrate-mono-mp3

# Opcional: pasta do cache de áudios
# TTS_CACHE_DIR=.cache/tts

# Para testar a interface sem chave, use:
# TTS_PROVIDER=mock
