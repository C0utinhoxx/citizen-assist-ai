# Copie este arquivo para .env e preencha para ativar a voz natural Azure.
# O .env não deve ser enviado ao Git nem compartilhado.

# azure = voz real | mock = áudio de teste sem chave
TTS_PROVIDER=azure

# Portal do Azure -> recurso Speech -> Chaves e ponto de extremidade
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_TTS_VOICE=pt-BR-ThalitaNeural

# Formato de saída do Azure (MP3 é o mais compatível com navegadores)
AZURE_TTS_FORMAT=audio-24khz-48kbitrate-mono-mp3

# Opcional: pasta do cache de áudios
# TTS_CACHE_DIR=.cache/tts

# Para testar a interface sem chave, use:
# TTS_PROVIDER=mock

# --- Ditado pelo servidor (opcional) ---
# O ditado do navegador (Web Speech API) pode falhar em alguns Macs.
# Como alternativa, o servidor local transcreve o áudio com a API do provedor.
# O áudio só é enviado quando o usuário toca em "Falar pelo computador".
# auto = usa OpenAI se houver chave, senão Groq; off = desativa
ASR_PROVIDER=auto

# OpenAI (a mesma chave usada pelo agente também funciona)
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (plano gratuito): https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# GROQ_BASE_URL=https://api.groq.com/openai/v1
