# Configuração opcional do modelo de linguagem.
# Copie para agente/.env e preencha apenas o provedor escolhido.
# O arquivo .env é ignorado pelo Git e nunca deve ser enviado ao repositório.

# auto | extrativo | groq | openai | ollama
CITIZEN_LLM_PROVIDER=auto

# Groq (plano gratuito): https://console.groq.com/keys
# GROQ_API_KEY=

# OpenAI (pago): https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Modelo e endpoint opcionais (sobrescrevem o padrão do provedor)
# CITIZEN_LLM_MODEL=llama-3.1-8b-instant
# CITIZEN_LLM_BASE_URL=https://api.groq.com/openai/v1

# Ollama local: instale em https://ollama.com e rode `ollama pull llama3.1`
# CITIZEN_LLM_PROVIDER=ollama
# CITIZEN_LLM_MODEL=llama3.1
